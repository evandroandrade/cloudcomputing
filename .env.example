# =============================================================================
# .env.example — Variáveis de ambiente necessárias
# Copie para .env e preencha com os valores reais.
# NUNCA comite o arquivo .env no Git.
# =============================================================================

# URL do projeto Supabase (pública — pode aparecer no código de forma controlada)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de service_role — SECRETA, somente para scripts locais e Edge Functions
# Encontre em: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXEMPLO_NAO_USAR

# Senha inicial do admin (não use matrícula para admin)
# Mínimo: 12 caracteres, letras + números + especiais
ADMIN_INITIAL_PASSWORD=TrocaEssa123!
